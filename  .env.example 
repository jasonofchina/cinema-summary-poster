# Cinema Summary Poster API Configuration
# ⚠️ 请勿将此文件提交至版本控制系统！
# 复制此文件为 .env 并填入真实密钥

# API Key for image generation service
# 获取地址：https://example.com/api-keys
# 轮换周期：每30天或怀疑泄露时立即更换
# 限额设置：建议在服务商后台设置每日/每月调用上限
CINEMA_POSTER_API_KEY=your_api_key_here

# Optional: Custom model endpoint (leave empty to use default)
# CINEMA_POSTER_MODEL_ENDPOINT=

# Optional: Request timeout in seconds (default: 60)
# CINEMA_POSTER_TIMEOUT=60
